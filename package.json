{
  "name": "ai-code-guardian",
  "version": "1.0.0",
  "description": "Real-time preventative feedback system for AI-generated code with visual warnings and quality analysis",
  "main": "dist/analyzer.js",
  "bin": {
    "ai-code-guardian": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/analyzer.ts --bundle --platform=node --target=node18 --outfile=dist/analyzer.js --minify --external:fs --external:path --external:child_process",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "code-review",
    "security",
    "quality",
    "real-time",
    "ai-safety",
    "code-analysis",
    "visual-feedback",
    "claude-code",
    "plugin"
  ],
  "author": "Vivek Patil",
  "license": "MIT",
  "homepage": "https://github.com/vivekspatil/ai-code-guardian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivekspatil/ai-code-guardian.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.19.37",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "esbuild": "^0.27.4",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "web-tree-sitter": "^0.20.8"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "bugs": {
    "url": "https://github.com/vivekspatil/ai-code-guardian/issues"
  }
}
