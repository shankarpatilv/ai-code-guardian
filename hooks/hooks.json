{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/analyze.sh",
            "args": ["--tool", "${tool_name}", "--file", "${file_path}", "--content", "${tool_output}"],
            "env": {
              "GUARDIAN_MODE": "real-time",
              "GUARDIAN_VISUAL": "true",
              "GUARDIAN_ROOT": "${CLAUDE_PLUGIN_ROOT}"
            }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/src/analyzer/pre-check.sh",
            "args": ["--validate-patterns"]
          }
        ]
      }
    ]
  }
}